# ---------------------------------------------------------------------------
# AssessIQ — root .gitignore
# ---------------------------------------------------------------------------

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Backend runtime data & secrets
backend/.assessiq_data/
**/.assessiq_data/
.env
.env.*
!.env.example

# Node / frontend
node_modules/
frontend/node_modules/
dist/
frontend/dist/
*.local

# Editor / OS
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# Logs
*.log
npm-debug.log*
