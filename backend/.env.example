# Copy to backend/.env and adjust. All values are optional — sensible defaults apply.

# --- LLM provider: openai | ollama | offline ------------------------------
# If "openai" is chosen but no OPENAI_API_KEY is set, it auto-falls back to
# "offline" so the server still runs.
ASSESSIQ_LLM_PROVIDER=openai

# OpenAI / OpenAI-compatible
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1   # set for OpenAI-compatible gateways

# Ollama (local open-source models)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# --- Embeddings -----------------------------------------------------------
ASSESSIQ_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Vector Database: faiss | chroma ----------------------------------------
# For local development: faiss (stores in backend/.assessiq_data/)
# For production / scalability: chroma (requires Chroma server)
ASSESSIQ_VECTOR_DB=faiss
# Only used if ASSESSIQ_VECTOR_DB=chroma:
# CHROMA_URL=http://localhost:8000

# --- Retrieval / generation tuning ----------------------------------------
ASSESSIQ_TOP_K=6
ASSESSIQ_QUESTIONS_PER_SET=6
ASSESSIQ_ANSWERABILITY_THRESHOLD=0.18
ASSESSIQ_CHUNK_SIZE=1000
ASSESSIQ_CHUNK_OVERLAP=200

# --- Storage / CORS -------------------------------------------------------
ASSESSIQ_DATA_DIR=backend/.assessiq_data
ASSESSIQ_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Auth / accounts ------------------------------------------------------
# When false (default) core routes allow anonymous access (frictionless demo);
# auth + admin routes still work. Set true to require a bearer token.
ASSESSIQ_REQUIRE_AUTH=false
ASSESSIQ_SECRET=change-me-to-a-long-random-string
ASSESSIQ_TOKEN_TTL_HOURS=168
# Seed admin created on first run (change the password!).
ASSESSIQ_ADMIN_USER=admin
ASSESSIQ_ADMIN_PASSWORD=admin123
